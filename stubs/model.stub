/**
 * QueryFlow whitelists: what API clients may filter, sort, search and include.
 * Leave a list out to use its default (filterable: id + fillable + timestamps, minus hidden).
 */
#[Queryable(
    searchable: [],
    includable: [],
)]
#[Fillable([])]
class {{ class }} extends Model
{
    use HasQueryFlow;
    {{ factory }}
}
